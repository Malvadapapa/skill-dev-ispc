# === ISPC Dev Skill - Configuración ===
# Copiá este archivo como .env y completá tus datos.

# Token de acceso personal de GitHub (con permisos: repo, project, read:org)
GITHUB_TOKEN=ghp_tu_token_aqui

# Nombre de tu rama personal de desarrollo (ej. cristian-vargas, juan-perez)
DEV_BRANCH_NAME=tu-nombre-aqui

# Organización de GitHub (no cambiar salvo que sea otro proyecto)
GITHUB_ORG=TeamYear3

# Nombre del repositorio
GITHUB_REPO=FCC_APP

# Número del proyecto V2 en GitHub
PROJECT_NUMBER=2

# Credenciales de Google OAuth2 para MCP y Google Drive / Sheets API
GOOGLE_CLIENT_ID=tu_google_client_id_aqui.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-tu_client_secret_aqui

